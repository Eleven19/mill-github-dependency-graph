//| mvnDeps:
//| - io.eleven19.mill-github-dependency-graph::mill-github-dependency-graph_mill$MILL_BIN_PLATFORM:@PLUGIN_VERSION@

package build

import mill._, scalalib._, scalajslib._

// Each module below is one dependency shape the plugin has had to get right.
// They are deliberately small: the point is the shape, not the size.

trait Fixture extends ScalaModule {
  def scalaVersion = "3.3.4"
}

/** Issue #3: the version lives in `depManagement`, not at the use site. */
object viaDepManagement extends Fixture {
  override def depManagement = super.depManagement() ++ Seq(
    mvn"dev.zio::zio-test:2.1.14"
  )
  override def mvnDeps = Seq(mvn"dev.zio::zio-test")
}

/** Issue #3: the version comes from a BOM. */
object viaBom extends Fixture {
  override def bomMvnDeps = Seq(
    mvn"com.fasterxml.jackson:jackson-bom:2.18.2"
  )
  override def mvnDeps = Seq(mvn"com.fasterxml.jackson.core:jackson-databind")
}

/** The BOM raises transitive versions above what the POM asked for. */
object bomOverridesTransitive extends Fixture {
  override def bomMvnDeps = Seq(
    mvn"com.fasterxml.jackson:jackson-bom:2.18.2"
  )
  override def mvnDeps = Seq(
    mvn"com.fasterxml.jackson.core:jackson-databind:2.15.0"
  )
}

/** Issue #12: `junit-platform-suite-engine` declares
  * `junit-platform-suite-commons` at runtime scope.
  */
object runtimeScoped extends Fixture {
  override def mvnDeps = Seq(
    mvn"org.junit.platform:junit-platform-suite-engine:1.11.4"
  )
}

/** One dependency in each of the three places a scope can pick from. */
object everyScope extends Fixture {
  override def mvnDeps = Seq(
    mvn"org.junit.platform:junit-platform-suite-engine:1.11.4"
  )
  override def runMvnDeps = Seq(mvn"org.slf4j:slf4j-simple:2.0.16")
  override def compileMvnDeps = Seq(mvn"org.projectlombok:lombok:1.18.36")
}

/** Proves `GraphScopeModule` is usable from a consumer build file, which no
  * unit test can show: the trait has to be importable from the published
  * artifact and mixable into an ordinary module.
  */
object declaresCompile extends Fixture
    with io.eleven19.mill.github.dependency.graph.GraphScopeModule {
  override def dependencyGraphScope = Task {
    io.eleven19.mill.github.dependency.graph.GraphScope.Compile
  }
  override def mvnDeps = Seq(
    mvn"org.junit.platform:junit-platform-suite-engine:1.11.4"
  )
}

/** An internal `moduleDeps` edge. `dependsOnInternal` declares none of
  * `internalLib`'s dependencies, but anyone consuming it gets them, so its
  * manifest has to report them.
  */
object internalLib extends Fixture {
  override def mvnDeps = Seq(mvn"com.lihaoyi::sourcecode:0.4.2")
}

object dependsOnInternal extends Fixture {
  override def moduleDeps = Seq(internalLib)
}

/** Issue #32: Scala.js library that platforms versionless `::` coords in
  * `bindDependency`, plus a depender that does not share that override.
  * Walking `moduleDeps` with the depender's binder used to look up the JVM
  * artifact (`sourcecode_3`) in a resolution that held the Scala.js one.
  */
def platformScalaDep(dep: Dep): Dep =
  dep.cross match {
    case mill.api.CrossVersion.Binary(false) =>
      dep.copy(cross = mill.api.CrossVersion.Binary(true))
    case mill.api.CrossVersion.Full(false) =>
      dep.copy(cross = mill.api.CrossVersion.Full(true))
    case _ => dep
  }

trait JsFixture extends ScalaJSModule {
  def scalaVersion = "3.3.4"
  def scalaJSVersion = "1.16.0"
  override def resolvedDepsWarnNonPlatform = false
}

object jsLib extends JsFixture {
  override def depManagement = super.depManagement() ++ Seq(
    mvn"com.lihaoyi::sourcecode:0.4.2"
  )
  override def mvnDeps = Seq(mvn"com.lihaoyi::sourcecode")
  override def bindDependency = Task.Anon { (dep: Dep) =>
    super.bindDependency()(platformScalaDep(dep))
  }
}

object jsLibDepender extends JsFixture {
  override def moduleDeps = Seq(jsLib)
}
