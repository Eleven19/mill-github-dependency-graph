package build.plugin

import mill._, scalalib._
import mill.scalalib.scalafmt.ScalafmtModule
import mill.contrib.buildinfo.BuildInfo

object `package` extends _root_.build.CommonScalaModule
    with _root_.build.PublishSupport
    with BuildInfo { self =>

  override def artifactName = "mill-github-dependency-graph"

  // The plugin compiles against the Mill API, so the published artifact is
  // specific to a Mill binary platform. Mill plugins signal this with a
  // `_mill<binaryPlatform>` suffix, giving `mill-github-dependency-graph_mill1_3`.
  override def platformSuffix = "_mill1"

  // Our own dependencies (upickle, requests, packageurl-java) are ordinary
  // libraries and carry no `_mill1` suffix, so the platform-dependency check
  // would flag every one of them.
  override def resolvedDepsWarnNonPlatform = false

  override def moduleDeps = Seq(build.domain, build.report)

  override def compileMvnDeps = super.compileMvnDeps() ++ Seq(
    mvn"com.lihaoyi::mill-libs-scalalib:${mill.api.BuildInfo.millVersion}",
    // `mill.resolve.Resolve` (used by `EvaluatorBridge.resolveSegments`) lives
    // in `mill-core-resolve`, which `mill-libs-scalalib` does not pull in.
    mvn"com.lihaoyi::mill-core-resolve:${mill.api.BuildInfo.millVersion}"
  )

  override def mvnDeps = super.mvnDeps() ++ Seq(
    mvn"com.lihaoyi::upickle:3.3.1",
    mvn"com.lihaoyi::requests:0.9.0",
    mvn"com.github.package-url:packageurl-java:1.5.0"
  )

  override def buildInfoMembers = Seq(
    BuildInfo.Value("detectorName", "mill-github-dependency-graph"),
    BuildInfo.Value("homepage", pomSettings().url),
    BuildInfo.Value("version", publishVersion())
  )

  override def buildInfoObjectName = "BuildInfo"
  override def buildInfoPackageName = "io.eleven19.mill.github.dependency.graph"

  object test extends ScalaTests with TestModule.Utest with ScalafmtModule {

    // `mill-testkit` gives us a real Mill `Evaluator` over a build defined in
    // test sources, so `Resolver` can be exercised against actual modules.
    // `mill-libs-scalalib` and `mill-core-resolve` are only `compileMvnDeps`
    // of the plugin, so the tests need them on their own runtime classpath.
    override def mvnDeps = super.mvnDeps() ++ Seq(
      mvn"com.lihaoyi::mill-testkit:${mill.api.BuildInfo.millVersion}",
      mvn"com.lihaoyi::mill-libs-scalalib:${mill.api.BuildInfo.millVersion}",
      mvn"com.lihaoyi::mill-core-resolve:${mill.api.BuildInfo.millVersion}",
      mvn"com.lihaoyi::utest:0.9.5"
    )

    // Hand the evaluated coordinates and a real published repository layout to
    // the test JVM, so the tests assert on what this build actually publishes
    // rather than on a restatement of the configuration above.
    override def forkEnv = Task {
      super.forkEnv() ++ Map(
        "PUBLISH_ORGANIZATION" -> self.pomSettings().organization,
        "PUBLISH_VERSION" -> self.publishVersion(),
        "PLUGIN_ARTIFACT_ID" -> self.artifactId(),
        "PLUGIN_M2_REPO" -> self.publishLocalTestRepo().path.toString,
        "DOMAIN_ARTIFACT_ID" -> build.domain.artifactId(),
        "DOMAIN_M2_REPO" -> build.domain.publishLocalTestRepo().path.toString
      )
    }
  }
}
